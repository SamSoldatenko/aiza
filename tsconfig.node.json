{
  "compilerOptions": {
    "composite": true,
    "lib": ["esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "target": "ES2022",
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.mts"]
}
